# Copy to .env (never commit .env). Read by the brain and the terminal at start-up.

# --- Brain ---
# Claude API key. Leave unset if you've run `ant auth login` on this machine.
ANTHROPIC_API_KEY=
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765
JARVIS_MODEL=claude-opus-5-5
# low = snappiest replies for conversation; raise for harder questions
JARVIS_EFFORT=low
# faster-whisper model: large-v3-turbo (accurate; ~0.1 s per sentence on an RTX GPU),
# small.en (use this if the brain has no NVIDIA GPU)
JARVIS_STT_MODEL=large-v3-turbo
# cuda, cpu, or auto (try cuda, fall back to cpu)
JARVIS_STT_DEVICE=auto
# Voice (fetch files with brain/scripts/get_voice.py). Kokoro sounds far more natural:
#   kokoro:bm_daniel                      one voice (British: bm_daniel/george/lewis/fable,
#                                         bf_emma/isabella/alice/lily)
#   kokoro:bm_daniel=0.65,bm_lewis=0.35   a blend
#   voices/en_GB-alan-medium.onnx         a Piper voice file instead
JARVIS_VOICE=kokoro:bm_daniel
# Kokoro pace: 1.0 normal; 1.12 is closest to the films' J.A.R.V.I.S.
JARVIS_VOICE_SPEED=1.12

# --- Terminal ---
JARVIS_BRAIN_URL=ws://localhost:8765/ws
JARVIS_TERMINAL_ID=dev-pc
# Port the terminal serves the touchscreen page on
JARVIS_UI_PORT=8080
# 0..1, how sure the "hey Jarvis" model must be to wake straight away
JARVIS_WAKE_THRESHOLD=0.5
# Below that but above this, the brain's speech-to-text checks for any of the wake phrases
JARVIS_WAKE_CANDIDATE=0.02
# Wake phrases (brain side; |-separated). "OK Jarvis" also wakes straight away.
JARVIS_WAKE_PHRASES=hey jarvis|ok jarvis|good morning jarvis|are you awake jarvis
# Mic level that counts as speech (int16 RMS). ~120 suits headsets; raise for noisy rooms.
JARVIS_SPEECH_RMS=120
# Seconds Jarvis keeps listening after answering, so you can carry on without "hey Jarvis" (0 = off)
JARVIS_FOLLOW_UP_S=10
# Seconds to wait for you to start talking after "hey Jarvis" or a tap
JARVIS_LISTEN_TIMEOUT_S=10

# --- Eye (ESP32-S3 mic node on USB; see docs/eye.md) ---
# How far the node sits from the middle of the screen, as you face it. Negative = left.
# Only used the first time a node is seen; after that its pose is in data/eye-nodes.json.
JARVIS_EYE_NODE_OFFSET_M=-0.2
# Flip to "right" if the eye looks the wrong way (you on its left, it looks right)
JARVIS_EYE_NODE_M1_SIDE=left
