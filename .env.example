# Copy to .env (never commit .env). Read by the brain and the terminal at start-up.

# --- Brain ---
# Claude API key. Leave unset if you've run `ant auth login` on this machine.
ANTHROPIC_API_KEY=
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765
JARVIS_MODEL=claude-opus-5-5
# low = snappiest replies for conversation; raise for harder questions
JARVIS_EFFORT=low
# faster-whisper model: large-v3-turbo (accurate; ~0.1 s per sentence on an RTX GPU),
# small.en (use this if the brain has no NVIDIA GPU)
JARVIS_STT_MODEL=large-v3-turbo
# cuda, cpu, or auto (try cuda, fall back to cpu)
JARVIS_STT_DEVICE=auto
# Piper voice file (.onnx) — fetch with brain/scripts/get_voice.py
JARVIS_VOICE=voices/en_GB-alan-medium.onnx

# --- Terminal ---
JARVIS_BRAIN_URL=ws://localhost:8765/ws
JARVIS_TERMINAL_ID=dev-pc
# Port the terminal serves the touchscreen page on
JARVIS_UI_PORT=8080
# 0..1, how sure the wake word model must be
JARVIS_WAKE_THRESHOLD=0.5
